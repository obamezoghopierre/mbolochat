DATABASE_URL=postgresql://mbolochat:mbolochat@localhost:5432/mbolochat
JWT_SECRET=change-me
PORT=3001

# Environnement d'exécution. En production, mets « production » : c'est ce qui
# empêche le code de réinitialisation du mot de passe d'être renvoyé au client ou
# écrit dans les journaux. Rien n'est renvoyé dès que cette valeur est autre que
# « development » ou « test ».
NODE_ENV=development

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des
# virgules. Les applications mobiles n'envoient pas d'en-tête Origin et s'en
# passent ; le client web doit y figurer, sinon ses appels sont refusés.
CORS_ORIGINS=http://localhost:8081

# Clé des URLs de médias signées (images de discussions et avatars). À défaut,
# JWT_SECRET sert de clé — une valeur propre est préférable, pour pouvoir tourner
# l'une sans tourner l'autre.
# MEDIA_SECRET=

# Appels : serveurs ICE servis à l'application (GET /calls/ice-servers).
# STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
# TURN_URLS="turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp"
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Chiffrement de bout en bout : activé par défaut. Les conversations chiffrées
# ne repassent jamais en clair ; mets « false » uniquement pour un diagnostic
# explicite (les endpoints /e2ee répondent alors 404).
E2EE_ENABLED=true

# Médias du réseau social : stockage objet compatible S3 (R2, MinIO, AWS).
# Sans ces variables, les routes /media/uploads répondent 503 ; le chat et le
# reste de l'API continuent de fonctionner avec le stockage local existant.
# SOCIAL_S3_ENDPOINT=http://127.0.0.1:9000
# SOCIAL_S3_REGION=us-east-1
# SOCIAL_S3_BUCKET=mbolochat-social
# SOCIAL_S3_ACCESS_KEY_ID=minio
# SOCIAL_S3_SECRET_ACCESS_KEY=minio-secret
# SOCIAL_S3_FORCE_PATH_STYLE=true
# Base publique des objets (CDN ou endpoint public du bucket), sans « / » final.
# SOCIAL_S3_PUBLIC_BASE_URL=https://cdn.example.com/mbolochat-social

# Worker média (`npm run worker:media`). Il lit la même base et le même stockage.
# MEDIA_WORKER_INTERVAL_MS=2000
# MEDIA_WORKER_BATCH=2
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
